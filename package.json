{
  "name": "pilzkarte-schweiz",
  "version": "0.1.0",
  "private": true,
  "description": "Interaktive Pilzbiotop-Karte für die Schweiz: Höhen-, Wald- und Geologiedaten von geo.admin.ch, Regen-Timing von Open-Meteo.",
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8080 --bind 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "e2e": "playwright test -c e2e/playwright.config.mjs",
    "master": "playwright test -c e2e/playwright.config.mjs e2e/master.spec.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "license": "MIT"
}
